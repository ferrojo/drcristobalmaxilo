---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  currentPage?: string;
}

const {
  title,
  description = "Especialistas en cirugía bucal y maxilofacial en Guadalajara. Implantes dentales, cirugía ortognática y más.",
  currentPage = "",
} = Astro.props;

const navLinks = [
  { label: "Inicio", href: "/" },
  { label: "Servicios", href: "/servicios" },
  { label: "Mi Trabajo", href: "/mitrabajo" },
  { label: "Sobre el Dr.", href: "/doctor" },
  { label: "Contacto", href: "/contacto" },
];
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} | Dr. Cristóbal Patiño</title>
    <link rel="icon" type="image/svg+xml" href="/drcristobalmaxilo.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- TopNavBar -->
    <nav
      id="nav-header"
      class="fixed top-0 w-full z-50 bg-navy/95 backdrop-blur-sm border-b border-teal/20 h-20 md:h-24 transition-all duration-300 ease-in-out"
    >
      <div
        class="max-w-container mx-auto px-6 h-full flex items-center justify-between"
      >
        <a href="/" class="flex items-center gap-3 group">
          <img
            id="nav-logo"
            src="/maxilo-logo.webp"
            alt="Dr. Cristóbal Patiño Rojo Logo"
            class="h-14 w-auto md:h-20 md:w-35 rounded-full object-cover ring-2 ring-teal/40 group-hover:ring-teal transition-all duration-300"
          />
          <span
            id="nav-title"
            class="text-lg md:text-xl font-semibold text-white font-doctor antialiased leading-tight transition-all duration-300"
          >
            Dr. Cristóbal Patiño
          </span>
        </a>

        <!-- Desktop Nav -->
        <div class="hidden md:flex items-center space-x-10">
          {
            navLinks.map((link) => (
              <a
                href={link.href}
                class={`font-medium transition-colors text-base ${
                  currentPage === link.href
                    ? "text-white"
                    : "text-slate-300 hover:text-white"
                }`}
              >
                {link.label}
              </a>
            ))
          }
        </div>

        <!-- CTA Button (desktop only) -->
        <a
          href="/agendar"
          class="hidden md:inline-block bg-on-primary text-black px-6 py-3 rounded-lg font-medium text-cta hover:bg-primary hover:text-white transition-all duration-300 border border-primary"
        >
          Agendar Cita
        </a>

        <!-- Mobile menu button -->
        <button
          id="mobile-menu-btn"
          class="md:hidden p-3 text-slate-200 hover:text-white transition-colors"
          aria-label="Menú"
        >
          <svg
            class="w-8 h-8"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>

      <!-- Mobile Menu -->
      <div
        id="mobile-menu"
        class="hidden md:hidden bg-navy border-t border-teal/20 px-6 py-4 space-y-4"
      >
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class="block text-slate-200 font-medium hover:text-white transition-colors text-center text-md"
            >
              {link.label}
            </a>
          ))
        }
        <a
          href="/agendar"
          class="block bg-primary text-white px-6 py-3 rounded-xl text-center font-cta text-md"
        >
          Agendar Cita
        </a>
      </div>
    </nav>

    <!-- Page Content -->
    <main>
      <slot />
    </main>

    <!-- Footer -->
    <footer
      class="w-full border-t border-outline-variant/30 bg-surface-container-low pt-16 pb-8 mt-20"
    >
      <div
        class="max-w-container mx-auto px-6 grid grid-cols-1 md:grid-cols-3 gap-12"
      >
        <!-- Brand -->
        <div class="space-y-4">
          <div class="text-2xl font-semibold text-primary font-h1">MaxiloSalud</div>
          <p class="text-sm text-on-surface-variant leading-relaxed max-w-xs">
            Especialistas en Cirugía Bucal y Maxilofacial. Tecnología de
            vanguardia para tu bienestar.
          </p>
          <div class="flex items-center gap-2 text-sm text-on-surface-variant">
            <span class="material-symbols-outlined text-base">schedule</span>
            <span>Lun–Vie 9:00–20:00 | Sáb 9:00–14:00</span>
          </div>
        </div>

        <!-- Quick links -->
        <div class="space-y-4">
          <p class="text-sm font-medium text-on-surface-variant">Sitio</p>
          <div class="space-y-3">
            {
              navLinks.map((link) => (
                <a
                  href={link.href}
                  class="block text-sm text-on-surface-variant hover:text-primary transition-colors"
                >
                  {link.label}
                </a>
              ))
            }
          </div>
        </div>

        <!-- Legal -->
        <div class="space-y-4">
          <p class="text-sm font-medium text-on-surface-variant">Legal</p>
          <div class="space-y-3">
            <a
              href="/privacidad"
              class="block text-sm text-on-surface-variant hover:text-primary transition-colors"
              >Aviso de Privacidad</a
            >
            <a
              href="/terminos"
              class="block text-sm text-on-surface-variant hover:text-primary transition-colors"
              >Términos de Servicio</a
            >
            <a
              href="/faq"
              class="block text-sm text-on-surface-variant hover:text-primary transition-colors"
              >Preguntas Frecuentes</a
            >
          </div>
        </div>
      </div>

      <div
        class="max-w-container mx-auto px-6 mt-12 pt-8 border-t border-outline-variant/30 flex flex-col md:flex-row justify-between items-center gap-4"
      >
        <p class="text-xs text-on-surface-variant">
          © 2026 Cirujano Maxilofacial | Cristóbal Patiño Rojo. Todos los
          derechos reservados. Sitio desarrollado por Fernando Patiño
        </p>
        <div class="flex items-center gap-6 text-on-surface-variant">
          <a
            href="tel:+523312345678"
            class="hover:text-primary transition-colors"
          >
            <span class="material-symbols-outlined text-lg">phone</span>
          </a>
          <a
            href="mailto:contacto@maxilosalud.mx"
            class="hover:text-primary transition-colors"
          >
            <span class="material-symbols-outlined text-lg">mail</span>
          </a>
          <a
            href="https://maps.google.com"
            target="_blank"
            class="hover:text-primary transition-colors"
          >
            <span class="material-symbols-outlined text-lg">location_on</span>
          </a>
        </div>
      </div>
    </footer>

    <script>
      const btn = document.getElementById("mobile-menu-btn");
      const menu = document.getElementById("mobile-menu");
      btn?.addEventListener("click", () => {
        menu?.classList.toggle("hidden");
      });

      // ── Shrink nav on scroll ──────────────────────────────
      const nav = document.getElementById("nav-header");
      const logo = document.getElementById("nav-logo");
      const title = document.getElementById("nav-title");

      const SCROLL_THRESHOLD = 10;
      const isMobile = () => window.innerWidth < 768;

      function updateNav() {
        const scrolled = window.scrollY > SCROLL_THRESHOLD;
        const mobile = isMobile();

        if (nav) {
          // Mobile: 80px → 56px | Desktop: 96px → 64px
          nav.style.height = scrolled ? (mobile ? "70px" : "64px") : "";
          nav.classList.toggle("shadow-lg", scrolled);
          nav.classList.toggle("shadow-sm", !scrolled);
        }

        if (logo) {
          // Logo reducido al scrollear (mobile: oculta el cambio pues ya es pequeño)
          logo.style.height = scrolled && !mobile ? "44px" : "";
          logo.style.width = scrolled && !mobile ? "auto" : "";
        }

        if (title) {
          // Texto reducido al scrollear
          title.style.fontSize = scrolled ? (mobile ? "16px" : "16px") : "";
        }
      }

      window.addEventListener("scroll", updateNav, { passive: true });
      window.addEventListener("resize", updateNav, { passive: true });
      updateNav(); // estado inicial
    </script>
  </body>
</html>
